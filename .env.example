# ─────────────────────────────────────────────────────────────
# Slyce Merchant Portal — environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values,
# then restart `npm run dev`.
# ─────────────────────────────────────────────────────────────

# (Optional) Override the API base. Leave empty to use the built-in
# dev proxy (/api -> Azure backend, configured in vite.config.ts).
# VITE_API_BASE=/api

# One-time defaults so a merchant sees everything wired right after login,
# WITHOUT entering anything in Settings or knowing about tokens.
# These are only used as a fallback when the login token does NOT already
# contain the IDs. Get the real values from your restaurant approval / admin.
VITE_DEFAULT_RESTAURANT_ID=
VITE_DEFAULT_BRANCH_ID=
